# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Environment ───────────────────────────────────────────────────────
# Vite loads .env, .env.local, .env.[mode] and .env.[mode].local. The rule
# used to be a bare `.env`, so .env.production / .env.local were trackable —
# and anything a VITE_* var holds ships inside the browser bundle. Blanket-
# ignore every variant, then re-admit the template.
.env
.env.*
!.env.example

# package-lock.json is intentionally NOT ignored — it MUST be committed for
# reproducible production installs (npm ci).

node_modules/

*.local

# ── Credentials / keys (NEVER commit) ─────────────────────────────────
# This section did not exist. A bare `credentials.json` in the mobile repo was
# committed with the release keystore passwords in it, so the patterns below
# are deliberately broad AND include the bare filename — `*-credentials.json`
# alone does not match `credentials.json`.
#
# NOTE: a .gitignore rule does NOT untrack an already-tracked file. When
# adding a secret here, also run: git rm --cached <file>
credentials.json
credentials/
*-credentials.json
*-service-account.json
serviceAccountKey.json
google-services.json
*.pem
*.key
*.p12
*.jks
*.keystore

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Build output — regenerated by `npm run build`. Committing it is what let the
# audit measure a stale 5.1 MB bundle from the repo (§4.1/§8.1). Netlify builds
# from source (netlify.toml: command = "npm run build"), so nothing deploys
# from a committed dist/.
dist/
dist-ssr/

# Test coverage (vitest)
coverage/

# Netlify CLI local state
.netlify/

# TypeScript incremental build info
*.tsbuildinfo

# A renamed .git from a previous session — never commit a repository as files.
.git_disabled/

# Generated lint artefact (§10.3)
lint_report.json
